# photo-wall env contract
# Copy to .env for local development; the compose.yaml local preview reads the
# same keys. Production (Portainer stack `photo-wall`) sets its own values in
# deploy/compose.portainer.yaml and never reads this file.

# --- Library source ---
# Absolute host path to the photo library mounted into the container at /photos:ro.
# Bind-mounted read-only. Subdirectories are scanned recursively (year/event/photo layouts welcome).
PHOTO_WALL_HOST_LIBRARY_PATH=/absolute/host/path/to/photos

# In-container library root. Must match the container side of the /photos mount.
# Override only if you remap the mount target.
PHOTO_WALL_LIBRARY_ROOT=/photos

# --- App data ---
# Host path to the local preview's writable app-data root, mounted at /data.
# Holds snapshots and the derivative cache; both can be rebuilt. Keep it apart
# from the native server's .photo-wall-data: the snapshot records the library
# path each server sees. Create it before the first `docker compose up`.
PHOTO_WALL_LOCAL_DATA_PATH=./.photo-wall-data-local

# Host port for the local preview (production uses 8092, native dev 5176).
PHOTO_WALL_LOCAL_PORT=8093

# In-container app-data root. Must match the container side of the /data mount.
PHOTO_WALL_DATA_ROOT=/data

# --- Server bind ---
# Container-internal bind address. 0.0.0.0 is required so the LAN host port reaches the app.
PHOTO_WALL_BIND_HOST=0.0.0.0

# Container-internal bind port. The preview maps PHOTO_WALL_LOCAL_PORT to it.
PHOTO_WALL_PORT=3001

# --- Runtime ---
# 'development' | 'production' | 'test'
NODE_ENV=development

# Log level for structured server logs: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
PHOTO_WALL_LOG_LEVEL=info

# Dev-machine escape hatch: when true, scan only top-level year directories
# like 2020/, 2022/, 2025/ and ignore root-level files plus non-year top-level
# folders such as Lightroom/, Screenshots/, Camera Roll/, etc.
PHOTO_WALL_SCAN_TOP_LEVEL_YEARS_ONLY=false

# Pre-generate overview thumbnails for the whole library in the background
# after startup and each rescan (stored under the data root's cache/).
PHOTO_WALL_PREWARM_DERIVATIVES=true

# --- Curation ---
# Curation turns on once a curator PIN exists. Normally you choose it in the
# browser: open /curate and enter the setup code the server prints in its
# log (also saved as setup-code in the curation folder). Setting a PIN here
# instead overrides the chosen one.
PHOTO_WALL_CURATOR_PIN=

# Where curation settings, the photo-move log and share links live. Unlike the
# data root this can't be rebuilt, so back it up. Must be outside the library.
# Native runs default to <data root>/curation, and both the preview and
# production mount that same ./.photo-wall-data/curation at /curation, so dev
# and prod share curation
# with no setting. Override only to move it (e.g. somewhere backed up):
# PHOTO_WALL_CURATION_ROOT=/absolute/path/to/photo-wall-curation   (native)
# PHOTO_WALL_HOST_CURATION_PATH=/absolute/path/to/photo-wall-curation (Docker)

# The curator can hide/restore photos (moved between an album and its _hidden
# folder) whenever the library is writable. In the preview, set
# PHOTO_WALL_LIBRARY_READ_ONLY=false to mount it writable (production already is). Set
# PHOTO_WALL_LIBRARY_WRITES=false to forbid moves even then.
PHOTO_WALL_LIBRARY_READ_ONLY=true
